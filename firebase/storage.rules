rules_version = '2';

// ============================================================================
// ADDA SOCIAL NETWORK — PHASE 1 STORAGE SECURITY RULES
// ============================================================================
// নিরাপত্তা ধারণা (Security Philosophy):
// ধাপ ১-এ কোনো ছবি বা ফাইল আপলোড নেই। Zero-Trust নীতি অনুসারে সব পাথ বন্ধ রাখা হয়েছে।
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
