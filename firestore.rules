rules_version = '2';

// ============================================================================
// ADDA SOCIAL NETWORK — PHASE 1 ZERO-TRUST SECURITY RULES
// ============================================================================
// নিরাপত্তা ধারণা (Security Philosophy):
// ১. Default Deny-All: ডিফল্টভাবে ডাটাবেজের সব কালেকশন ও ডকুমেন্ট পড়া/লেখা সম্পূর্ণ বন্ধ।
// ২. Least Privilege (ধাপ ১): শুধুমাত্র `users` এবং `usernames` কালেকশন খোলা আছে।
//    ব্যবহারকারী শুধুমাত্র নিজের `users/{userId}` ডকুমেন্ট পড়তে ও লিখতে পারবে।
//    অন্য ব্যবহারকারীর প্রোফাইল পড়ার নিয়ম পরের ধাপে খোলা হবে (PII ও গোপনীয়তা সুরক্ষার জন্য)।
// ৩. Counter & System Field Protection (Privilege Escalation Guard):
//    `followersCount`, `followingCount`, `postsCount`, `isVerified`, `isBanned`
//    ইত্যাদি সংবেদনশীল ও কাউন্টার ফিল্ড ক্লায়েন্ট অ্যাপ থেকে কখনোই তৈরি বা পরিবর্তন করা যাবে না।
//    `users` ডকুমেন্টে কোনো `role` ফিল্ড নেই; অ্যাডমিন রোল পরবর্তীতে Firebase Auth Custom Claims দিয়ে নিয়ন্ত্রিত হবে।
// ৪. Atomic Unique Username Claim (`usernames/{username}`):
//    - `create` শুধুমাত্র তখনই অনুমোদিত যখন:
//      (ক) ব্যবহারকারী লগইন করা (`isSignedIn()`),
//      (খ) ইউজারনেমটি `^[a-z0-9_]{3,24}$` ফরম্যাট মেনে চলে,
//      (গ) ডকুমেন্টটি আগে থেকে নেই (`!exists(...)`),
//      (ঘ) ফিল্ড শুধুমাত্র `uid` ও `createdAt` এবং `data.uid == request.auth.uid`,
//      (ঙ) একই ব্যাচ বা ট্রানজ্যাকশনে `users/{request.auth.uid}` ডকুমেন্টের `username` ফিল্ডটি এই `username`-এর সমান (`getAfter(...)`)।
//    - `update` সম্পূর্ণ নিষিদ্ধ (`allow update: if false;`), তাই আগের নেওয়া নাম ওভাররাইট করা অসম্ভব।
//    - `delete` শুধুমাত্র মালিক (`existing().uid == request.auth.uid`) করতে পারবে।
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET: Default deny-all across the entire database
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. PRIMITIVE HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameFormat(uname) {
      return uname is string &&
             uname.size() >= 3 &&
             uname.size() <= 24 &&
             uname.matches('^[a-z0-9_]+$');
    }

    // 3. ENTITY VALIDATION BLUEPRINTS
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             isValidUsernameFormat(data.username) &&
             data.email is string && data.email.size() <= 120 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 160)) &&
             data.language is string && (data.language == 'bn' || data.language == 'en') &&
             data.themeMode is string && (data.themeMode == 'system' || data.themeMode == 'light' || data.themeMode == 'dark') &&
             data.onboardingCompleted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUsernameClaim(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.uid.size() >= 1 &&
             data.uid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    // 4. USERS COLLECTION (Phase 1: Strictly owner-only read/write; no role field; client cannot write counters/flags)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      // CREATE: Strictly forbids followersCount, followingCount, postsCount, isVerified, isBanned
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'uid',
                         'displayName',
                         'username',
                         'email',
                         'language',
                         'themeMode',
                         'onboardingCompleted',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'uid',
                         'displayName',
                         'username',
                         'email',
                         'photoUrl',
                         'bio',
                         'language',
                         'themeMode',
                         'onboardingCompleted',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      // UPDATE: Validation helper first; immutable uid, email, createdAt; strictly allowlisted mutable keys
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'username',
                         'photoUrl',
                         'bio',
                         'language',
                         'themeMode',
                         'onboardingCompleted',
                         'updatedAt'
                       ]);

      allow delete: if false;
    }

    // 5. USERNAMES COLLECTION (Global uniqueness registry with atomic getAfter verification)
    match /usernames/{username} {
      // Signed-in users can check a specific username's availability by ID, but cannot list/scrape all usernames
      allow get: if isSignedIn() && isValidUsernameFormat(username);
      allow list: if false;

      // CREATE: Only when signed in, format valid, document does not exist before,
      // fields are strictly ['uid', 'createdAt'], data.uid == request.auth.uid,
      // and in the same batch/transaction users/{request.auth.uid}.data.username == username
      allow create: if isSignedIn() &&
                       isValidUsernameFormat(username) &&
                       !exists(/databases/$(database)/documents/usernames/$(username)) &&
                       incoming().keys().hasAll(['uid', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'createdAt']) &&
                       isValidUsernameClaim(incoming()) &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      // UPDATE: Never allowed — once claimed, nobody can overwrite it
      allow update: if false;

      // DELETE: Only the owner who claimed the username can delete it
      allow delete: if isSignedIn() &&
                       isValidUsernameFormat(username) &&
                       existing().uid == request.auth.uid;
    }
  }
}
