rules_version = '2';

// ============================================================================
// ADDA SOCIAL NETWORK — PHASE 1 ZERO-TRUST SECURITY RULES
// ============================================================================
// নিরাপত্তা ধারণা (Security Philosophy):
// ১. Default Deny-All: ডিফল্টভাবে ডাটাবেজের সব কালেকশন ও ডকুমেন্ট পড়া/লেখা সম্পূর্ণ বন্ধ।
// ২. Least Privilege (ধাপ ১): শুধুমাত্র `users` এবং `usernames` কালেকশন খোলা আছে।
//    ব্যবহারকারী শুধুমাত্র নিজের `users/{userId}` ডকুমেন্ট `get` করতে ও লিখতে পারবে (`list` বন্ধ)।
// ৩. Email & Identity Verification:
//    `users` create এবং update উভয় ক্ষেত্রেই `data.email == request.auth.token.email` বাধ্যতামূলক।
// ৪. Bidirectional Username Integrity (দ্বিমুখী ইউজারনেম অখণ্ডতা):
//    - `users` create: একই ব্যাচে `usernames/{incoming().username}` ডকুমেন্টটি নতুন তৈরি হতে হবে
//      এবং `getAfter(usernames/{incoming().username}).data.uid == request.auth.uid` হতে হবে।
//    - `users` update: ইউজারনেম অপরিবর্তিত থাকলে অতিরিক্ত শর্ত নেই। কিন্তু ইউজারনেম বদলালে:
//      (ক) নতুন ইউজারনেমের ক্লেইম একই ব্যাচে তৈরি হয়ে `getAfter` অনুযায়ী নিজের `uid`-এর হতে হবে, এবং
//      (খ) পুরোনো ইউজারনেমের ক্লেইম একই ব্যাচে মুছে ফেলতে হবে (`!existsAfter(usernames/{existing().username})`)।
//    - `usernames` create: সংরক্ষিত নাম (`admin`, `support`, `adda` ইত্যাদি) নিষিদ্ধ, ডকুমেন্ট আগে থেকে
//      থাকতে পারবে না (`!exists`), এবং একই ব্যাচে `getAfter(users/{uid}).data.username == username` হতে হবে।
//    - `usernames` delete: শুধুমাত্র মালিক মুছতে পারবে এবং একই ব্যাচে তার `users/{uid}.username`
//      অন্য নামে পরিবর্তিত হতে হবে (`getAfter(users/{uid}).data.username != username`)।
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET: Default deny-all across the entire database
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. PRIMITIVE HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isReservedUsername(uname) {
      return uname in [
        'admin',
        'administrator',
        'support',
        'moderator',
        'mod',
        'adda',
        'official',
        'staff',
        'help',
        'system',
        'root',
        'null',
        'undefined'
      ];
    }

    function isValidUsernameFormat(uname) {
      return uname is string &&
             uname.size() >= 3 &&
             uname.size() <= 24 &&
             uname.matches('^[a-z0-9_]+$') &&
             !isReservedUsername(uname);
    }

    // 3. ENTITY VALIDATION BLUEPRINTS
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             isValidUsernameFormat(data.username) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             request.auth.token.email != null && data.email == request.auth.token.email &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 160)) &&
             data.language is string && (data.language == 'bn' || data.language == 'en') &&
             data.themeMode is string && (data.themeMode == 'system' || data.themeMode == 'light' || data.themeMode == 'dark') &&
             data.onboardingCompleted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUsernameClaim(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.uid.size() >= 1 &&
             data.uid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function hasMatchingNewUsernameClaimInBatch(uname) {
      return !exists(/databases/$(database)/documents/usernames/$(uname)) &&
             existsAfter(/databases/$(database)/documents/usernames/$(uname)) &&
             getAfter(/databases/$(database)/documents/usernames/$(uname)).data.uid == request.auth.uid;
    }

    function isValidUsernameUpdateTransition() {
      return incoming().username == existing().username || (
        hasMatchingNewUsernameClaimInBatch(incoming().username) &&
        !existsAfter(/databases/$(database)/documents/usernames/$(existing().username))
      );
    }

    // 4. USERS COLLECTION (Phase 1: Owner-only get/create/update; list and delete disabled)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // CREATE: Requires atomic creation of usernames/{incoming().username} owned by request.auth.uid
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'uid',
                         'displayName',
                         'username',
                         'email',
                         'language',
                         'themeMode',
                         'onboardingCompleted',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'uid',
                         'displayName',
                         'username',
                         'email',
                         'photoUrl',
                         'bio',
                         'language',
                         'themeMode',
                         'onboardingCompleted',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       hasMatchingNewUsernameClaimInBatch(incoming().username);

      // UPDATE: Enforces schema, immutable uid/email/createdAt, and atomic username swap if username changed
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'username',
                         'photoUrl',
                         'bio',
                         'language',
                         'themeMode',
                         'onboardingCompleted',
                         'updatedAt'
                       ]) &&
                       isValidUsernameUpdateTransition();

      allow delete: if false;
    }

    // 5. USERNAMES COLLECTION (Global uniqueness registry with bidirectional atomic integrity)
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsernameFormat(username);
      allow list: if false;

      // CREATE: Non-reserved valid username, did not exist before, owned by caller,
      // and in the same batch users/{uid}.username == username
      allow create: if isSignedIn() &&
                       isValidUsernameFormat(username) &&
                       !exists(/databases/$(database)/documents/usernames/$(username)) &&
                       incoming().keys().hasAll(['uid', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'createdAt']) &&
                       isValidUsernameClaim(incoming()) &&
                       existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      // UPDATE: Never allowed
      allow update: if false;

      // DELETE: Only owner, and only when users/{uid}.username is changed to a different valid username in the same batch
      allow delete: if isSignedIn() &&
                       isValidUsernameFormat(username) &&
                       existing().uid == request.auth.uid &&
                       existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != username;
    }
  }
}
